# =============================================================================
# FINDtech API — PRODUCTION (Render)
# Set these in Render Dashboard → Environment
# =============================================================================

ENVIRONMENT=production
DEBUG=false
APP_NAME=FINDtech API

# MongoDB Atlas — Network Access must allow 0.0.0.0/0 or Render IPs
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/findtech?retryWrites=true&w=majority
MONGODB_DB_NAME=findtech

# JWT — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<paste-48-char-random-secret-here>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Your Vercel frontend URL(s) — comma-separated, NO wildcards
# Include production + preview if needed:
# CORS_ORIGINS=https://findtech.vercel.app,https://findtech-git-main-you.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# Render service hostname (from Render dashboard URL)
ALLOWED_HOSTS=findtech-api.onrender.com
