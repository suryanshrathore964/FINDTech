# =============================================================================
# FINDtech API — LOCAL DEVELOPMENT
# =============================================================================

ENVIRONMENT=development
DEBUG=true
APP_NAME=FINDtech API

MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/findtech?retryWrites=true&w=majority
MONGODB_DB_NAME=findtech

# Local dev without MongoDB: set true (auto-fallback if MongoDB unreachable in development)
USE_MEMORY_DB=false

# Generate: python -c "from app.config import generate_secret_key; print(generate_secret_key())"
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=*
